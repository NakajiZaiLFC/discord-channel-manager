{
  "name": "discord-channel-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Bot-mediated Discord channel manager with owner verification",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
